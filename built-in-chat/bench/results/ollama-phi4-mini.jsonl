{"kind": "result", "set_version": "1", "set_hash": "de65c2d243a2", "runtime": "ollama", "runtime_version": "0.40.18", "browser": null, "browser_version": null, "model_label": "phi4-mini", "model_detail": {"family": "phi3", "parameter_size": "3.8B", "quantization": "Q4_K_M", "format": "gguf"}, "settings_requested": {"temperature": 0, "topK": 1, "seed": 42, "num_predict": 2048}, "settings_used": {"temperature": 0, "topK": 1, "seed": 42, "num_predict": 2048}, "id": "open-sky", "category": "open", "scorer": "timed", "ts": "2026-11-24T17:35:52+00:00", "output": "The sky appears blue to the human eye because of Rayleigh scattering, which is the scattering of sunlight by the molecules in the Earth's atmosphere. Blue light is scattered more than other colors because it travels as shorter, smaller waves. This phenomenon occurs because when sunlight passes through the atmosphere, the shorter (blue) wavelengths are scattered in all directions by the gases and particles in the air, making the sky look blue to us during the day.", "chars": 467, "ttft_ms": 43.0, "total_ms": 1302.7, "create_ms": null, "in_tokens": 23, "out_tokens": 88, "tokens_source": "ollama eval_count", "tok_per_s": 69.85, "chars_per_s": 370.73, "pass": null, "error": null}
